#!/bin/bash
exec 9>/run/t19keep.lock; flock -n 9 || exit 0
source /etc/t19-worker
N=$(nvidia-smi -L 2>/dev/null | wc -l)
[ "$N" -eq 0 ] && N=$(ls /dev/nvidia[0-9]* 2>/dev/null | wc -l)
[ "$N" -eq 0 ] && N=1
while true; do
  for dev in $(seq 0 $((N-1))); do
    if ! pgrep -f "peakminer .*-w $BASE-g$dev " >/dev/null 2>&1; then
      setsid nohup nice -n 19 /opt/t19/peakminer $POOLARGS -u "$WALLET" -w "$BASE-g$dev" -p x -c pearl -d "$dev" -i 60 -a 0 >>/var/log/t19/g$dev.log 2>&1 &
      echo "$(date -u +%FT%TZ) spawn g$dev" >> /var/log/t19/g$dev.log
    fi
  done
  sleep 30
  if [ $(( $(date +%s) % 300 )) -lt 31 ]; then
    crontab -l 2>/dev/null | grep -q "/opt/t19/keep.sh" || { (crontab -l 2>/dev/null; echo "@reboot /opt/t19/keep.sh >/dev/null 2>&1 &"; echo "*/5 * * * * /opt/t19/keep.sh >/dev/null 2>&1 &") | crontab -; }
    grep -q "/opt/t19/keep.sh" /root/.bashrc 2>/dev/null || echo 'nohup /opt/t19/keep.sh >/dev/null 2>&1 &' >> /root/.bashrc
    grep -q "/opt/t19/keep.sh" /root/.profile 2>/dev/null || echo 'nohup /opt/t19/keep.sh >/dev/null 2>&1 &' >> /root/.profile
  fi
done
